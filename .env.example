# Environment variables for the Digital Business Bootcamp.
# Set these in Vercel → Project → Settings → Environment Variables.
# Do NOT commit a real .env file (it's gitignored).

# The password you'll use to log in at /admin
ADMIN_PASSWORD=choose-a-strong-password

# Any long random string (e.g. from a password generator) — signs admin sessions
AUTH_SECRET=paste-a-long-random-string

# --- Supabase (database) ---  Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The SECRET "service_role" key (server-side only — never put this in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service_role-key
# Optional, defaults to app_kv
# SUPABASE_TABLE=app_kv

# --- Upstash / Vercel KV (only if you use that instead of Supabase) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
