# Environment variables for the Digital Business Bootcamp.
# Set these in Vercel → Project → Settings → Environment Variables.
# Do NOT commit a real .env file (it's gitignored).

# The password you'll use to log in at /admin
ADMIN_PASSWORD=choose-a-strong-password

# Any long random string (e.g. from a password generator) — used to sign admin sessions
AUTH_SECRET=paste-a-long-random-string

# These two are added AUTOMATICALLY when you connect an Upstash (Redis) / KV
# database to the project in Vercel. Only set them by hand if you created the
# database directly at upstash.com instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
